<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">
    <persistence-unit name="CsspSismosPU" transaction-type="RESOURCE_LOCAL">
        <!-- GlassFish incluye EclipseLink como proveedor JPA por defecto. -->
        <provider>org.eclipse.persistence.jpa.PersistenceProvider</provider>
        <!-- Las clases @Entity se agregan aquí a medida que se crean (departamento, provincia, ...). -->
        <properties>
            <!-- El script database/01_schema.sql manda: JPA no crea ni modifica tablas. -->
            <property name="jakarta.persistence.schema-generation.database.action" value="none"/>
            <property name="eclipselink.logging.level" value="INFO"/>
            <property name="eclipselink.logging.parameters" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
